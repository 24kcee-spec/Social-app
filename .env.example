# Copy to .env (git-ignored) - NEVER commit real values. Staging/production values live in the host's secret store.
APP_ENV=local
PORT=4000
# Supabase > Connect > Session pooler connection string (password filled in, no special characters)
DATABASE_URL=
# Supabase > Project Settings > API Keys / Data API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: server-only, NOT used yet. Never put it in web/mobile code. Leave empty for now.
SUPABASE_SECRET_KEY=

# --- Web + mobile (Phase 1c). All optional for local dev; only PUBLIC values ever reach the browser/phone. ---
# Browser origins allowed to call the API, comma-separated. Empty = http://localhost:3000 in local, none elsewhere.
CORS_ORIGINS=
# Address the WEB app uses to reach the API (default http://localhost:4000).
PUBLIC_API_URL=
# Address the PHONE uses to reach the API: http://<this PC's LAN IP>:4000 (a phone cannot use localhost).
MOBILE_API_URL=
# Where password-reset emails send people (the web /reset page). Default http://localhost:3000.
PUBLIC_WEB_URL=
