APP_ENV=
CORS_ORIGINS=
DATABASE_URL=
DATABASE_CA_CERT_PATH=
MOBILE_API_URL=
PUBLIC_API_URL=
PUBLIC_WEB_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_URL=
EAS_PROJECT_ID=
ANDROID_PACKAGE=
ANDROID_GOOGLE_SERVICES_FILE=
MOBILE_ADS_PREVIEW=false
# Public account identifiers, not passwords. This app ID does not enable live serving.
ADMOB_ANDROID_APP_ID=
ADMOB_ANDROID_BANNER_ID=
# Off until account/app review, privacy/audience setup, device tests and eligible hosting.
MOBILE_ADS_ENABLED=false
# Operator-only input for scripts/prepare-admob-site.py; copy from your own AdMob account.
ADMOB_PUBLISHER_ID=
ADMOB_APP_ADS_TXT=
ANDROID_SIGNING_SHA256=
APPLE_TEAM_ID=
IOS_BUNDLE_IDENTIFIER=
PUSH_PROVIDER=disabled
EXPO_ACCESS_TOKEN=
# EAS CLI only; keep out of mobile extra/client bundles.
EXPO_TOKEN=

# Optional HTTPS management CLI only; never expose to web/mobile
SUPABASE_ACCESS_TOKEN=

# Optional integrations. Server-only; never add NEXT_PUBLIC_/EXPO_PUBLIC_ prefixes.
# Vercel Hobby is non-commercial. Use eligible hosting before enabling paid features.
COMMERCIAL_DEPLOYMENT_APPROVED=false
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUPPORT=
STRIPE_PRICE_AD_CREDIT=
AD_CREDITS_PER_PURCHASE=100
STRIPE_API_VERSION=
# Optional AdSense ownership verification only; never enables ad serving.
# Use only on a confirmed commercial-compatible host, with your own account.
ADSENSE_VERIFICATION_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_ADS_TXT=
# Turn on only after verifying an administrator authenticator and recovery procedure.
ADMIN_MFA_REQUIRED=false
# Keep direct mode off unless peer IP disclosure and unreliable NAT traversal are accepted.
CALL_ICE_MODE=disabled
TURN_URLS=
TURN_SHARED_SECRET=
STUN_URL=
# Live video remains disabled without a healthy separately hosted membership guard.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_GUARD_ENABLED=false
LIVEKIT_MAX_PARTICIPANTS=25
PUBLIC_SUPPORT_CONTACT=
# Optional email providers must also be configured in Supabase Auth, not only here.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
RESEND_API_KEY=
# Operator-only encrypted backup tooling.
BACKUP_AGE_RECIPIENT=
BACKUP_DIRECTORY=
BACKUP_AGE_IDENTITY_FILE=
SCRATCH_DATABASE_URL=
RESTORE_DISPOSABLE=false
# NUST deployment templates.
WEB_DOMAIN=
LIVE_DOMAIN=
SIDLE_SERVER_ENV_FILE=
TURN_CONFIG_FILE=
