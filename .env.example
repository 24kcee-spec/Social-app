# Copy to .env (git-ignored) - NEVER commit real values. Staging/production values live in the host's secret store.
APP_ENV=local
PORT=4000
# Supabase > Connect > Session pooler connection string (password filled in, no special characters)
DATABASE_URL=
# Supabase > Project Settings > API Keys / Data API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: server-only, NOT used yet. Never put it in web/mobile code. Leave empty for now.
SUPABASE_SECRET_KEY=
