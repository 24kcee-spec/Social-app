# Copy to .env (local) - NEVER commit real values. Staging/production values live in the host's secret store.
APP_ENV=local
PORT=4000
# Postgres connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=
# Supabase (added in the auth delivery). The service-role key must NEVER reach web/mobile bundles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
