# Replace placeholders in a private, root-owned file. Confirm the correct public IP and firewall.
listening-port=3478
min-port=49160
max-port=49200
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_SAME_TURN_SHARED_SECRET_AS_WEB_SERVER
realm=turn.your-domain.example
external-ip=REPLACE_WITH_PUBLIC_IP
no-cli
no-multicast-peers
no-loopback-peers
# Deny access from relay clients to internal destinations (RFC 1918/loopback/link-local).
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
total-quota=100
user-quota=4
max-bps=256000
# For turns: enable tls-listening-port=5349 plus cert/pkey paths with mounted trusted certificates.
# For a public UDP deployment disable unauthenticated STUN if it is not needed.
no-stun
