{
    "name":  "social-platform",
    "private":  true,
    "version":  "0.0.0",
    "description":  "Social Connection Platform (placeholder name) - monorepo",
    "packageManager":  "pnpm@9.15.4",
    "engines":  {
                    "node":  "\u003e=22.13"
                },
    "scripts":  {
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
