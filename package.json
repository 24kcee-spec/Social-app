{
  "name": "social-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Social Connection Platform (placeholder name) - monorepo",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @sp/web dev",
    "build": "pnpm --filter @sp/web build",
    "start": "pnpm --filter @sp/web start",
    "lint": "pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.6.3"
  }
}