{
  "name": "social-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Sidle social connection platform monorepo",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck || npm run typecheck --workspaces --if-present",
    "test": "pnpm -r --if-present test || npm test --workspaces --if-present",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify": "pnpm verify:migrations && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "react-dom": "19.2.3",
      "@types/react-dom": "19.2.3"
    }
  }
}
